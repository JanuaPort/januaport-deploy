#cloud-config
# JanuaPort-Single-Node (#776, #1497), abgeleitet aus deploy/hetzner/.
# First-Boot: Docker installieren, Volume mounten, Metadaten-Guard aktivieren.
# Anschließend legt der Betreiber die Geheimnisse ab und ruft jnpt-start auf.
# user_data enthält ausschließlich öffentliche Konfiguration: Hetzner liefert
# sie am Metadaten-Dienst ohne Anmeldung an Prozesse der VM aus.

package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - git
  - gnupg
  - iptables

write_files:
  # Nur öffentliche Compose-Konfiguration, keine Laufzeitgeheimnisse.
  - path: /opt/jnpt/staging/.env
    permissions: "0600"
    owner: root:root
    content: |
      JNPT_DOMAIN=${domain}
      JNPT_ACME_EMAIL=${acme_email}
      TS_HOSTNAME=${ts_hostname}
      JANUAPORT_IMAGE=${image_ref}
      JNPT_UPDATE_MANIFEST_URL=${update_manifest_url}
      JNPT_UPDATE_PUBLIC_KEYS=${update_public_keys}

  # Prüf-Token wie alle Laufzeitgeheimnisse manuell ablegen; ohne ihn inert.
  - path: /etc/jnpt-updater.conf
    permissions: "0600"
    owner: root:root
    content: |
      IMAGE_REPO=${updater_image_repo}
      COMPOSE_FILE=/opt/jnpt/repo/docker/docker-compose.prod.yml
      ENV_FILE=/opt/jnpt/repo/docker/.env
      CONTAINER=jnpt-jnpt-1
      DOMAIN=${domain}
      CHECK_TOKEN_FILE=/etc/jnpt-updater.token
      BACKUP_DIR=/data/backups

  # /run wird bei jedem Boot neu angelegt, vor einem Gateway-Start.
  - path: /etc/tmpfiles.d/jnpt-tunnel.conf
    permissions: "0644"
    owner: root:root
    content: |
      d /run/jnpt/tunnel 0750 65532 65532 -

  # Eigene Unit nach dem Muster des Plugin-Netz-Guards (README).
  # DOCKER-USER gilt für weitergeleiteten Bridge-Verkehr, nicht Host-Netzwerk.
  - path: /usr/local/sbin/jnpt-metadata-guard.sh
    permissions: "0755"
    owner: root:root
    content: |
      #!/bin/sh
      set -eu
      # Nicht nur -C: Ein vorhandener DROP hinter ACCEPT wäre wirkungslos.
      first=$(iptables -w -S DOCKER-USER | sed -n '2p')
      if [ "$first" != '-A DOCKER-USER -d 169.254.0.0/16 -j DROP' ]; then
        iptables -w -I DOCKER-USER 1 -d 169.254.0.0/16 -j DROP
      fi

  - path: /etc/systemd/system/jnpt-metadata-guard.service
    permissions: "0644"
    owner: root:root
    content: |
      [Unit]
      Description=JanuaPort: Container-Zugriff auf Link-Local/Metadaten sperren (#1497)
      After=docker.service
      Requires=docker.service
      PartOf=docker.service

      [Service]
      Type=oneshot
      RemainAfterExit=yes
      ExecStart=/usr/local/sbin/jnpt-metadata-guard.sh

      [Install]
      WantedBy=multi-user.target docker.service

  # Enthält keinen Token; git fragt Benutzer, dann Passwort über diesen Helfer.
  - path: /opt/jnpt/askpass.sh
    permissions: "0700"
    owner: root:root
    content: |
      #!/bin/sh
      case "$1" in
        Username*) printf '%s' 'x-access-token' ;;
        *) cat /etc/jnpt-bootstrap/git_token ;;
      esac

  # Bewusster Betreiberstart statt Warten in cloud-init. Auch private Klone
  # und Registry-Pulls erfolgen erst NACH der Dateiablage (README).
  - path: /usr/local/sbin/jnpt-start
    permissions: "0700"
    owner: root:root
    content: |
      #!/bin/sh
      set -eu
      umask 077
      fail() { printf '%s\n' "$*" >&2; exit 1; }
      [ "$(id -u)" = 0 ] || fail 'jnpt-start als root aufrufen.'
      for name in jnpt_master_key tailscale_authkey git_token registry_token; do
        path=/etc/jnpt-bootstrap/$name
        case "$name" in
          git_token|registry_token) [ -e "$path" ] || [ -L "$path" ] || continue ;;
        esac
        [ ! -L "$path" ] && [ -f "$path" ] && [ "$(stat -L -c '%u:%g:%a' "$path")" = '0:0:600' ] || fail "$name fehlt oder ist keine regulaere root:root/0600-Datei."
        LC_ALL=C awk 'NR != 1 || length($0) == 0 {bad=1} END {exit (NR != 1 || bad)}' "$path" || fail "$name muss genau eine nichtleere Zeile enthalten."
      done
      LC_ALL=C grep -Eq '^[0-9a-fA-F]{64}$' /etc/jnpt-bootstrap/jnpt_master_key || fail 'jnpt_master_key muss 64 Hex-Zeichen enthalten.'
      # --check führt dieselbe Dateiprüfung ohne Klon/Pull/Start aus.
      [ "$${1:-}" != '--check' ] || exit 0
      exec 9>/run/lock/jnpt-start.lock
      flock -n 9 || fail 'jnpt-start laeuft bereits.'
      systemctl restart jnpt-metadata-guard.service
      systemd-tmpfiles --create /etc/tmpfiles.d/jnpt-tunnel.conf

      # Ausschließlich Konfiguration klonen, kein Build auf der VM.
      if [ ! -d /opt/jnpt/repo/.git ]; then
        if [ -f /etc/jnpt-bootstrap/git_token ]; then
          GIT_ASKPASS=/opt/jnpt/askpass.sh GIT_TERMINAL_PROMPT=0 git -c credential.helper= clone --branch '${git_ref}' --depth 1 '${git_repo}' /opt/jnpt/repo
        else
          GIT_TERMINAL_PROMPT=0 git -c credential.helper= clone --branch '${git_ref}' --depth 1 '${git_repo}' /opt/jnpt/repo
        fi
      fi
      # Bei erneutem Start bestehende Betreiber-Konfiguration erhalten.
      if [ ! -f /opt/jnpt/repo/docker/.env ]; then
        install -m 0600 -o root -g root /opt/jnpt/staging/.env /opt/jnpt/repo/docker/.env
      fi
      install -d -m 0700 -o root -g root /opt/jnpt/repo/deploy/hetzner/secrets
      # Compose-file-Secrets bewahren Host-UID/Modus (kein Swarm). Für den
      # nonroot-Kern deshalb eine 0400-Lesekopie für UID 65532; die manuell
      # abgelegte Quelldatei bleibt root:root/0600 und außerhalb von /data.
      install -m 0400 -o 65532 -g 65532 /etc/jnpt-bootstrap/jnpt_master_key /opt/jnpt/repo/deploy/hetzner/secrets/jnpt_master_key
      install -m 0600 -o root -g root /etc/jnpt-bootstrap/tailscale_authkey /opt/jnpt/repo/deploy/hetzner/secrets/tailscale_authkey
      if [ -f /etc/jnpt-bootstrap/registry_token ]; then
        docker login ghcr.io -u x-access-token --password-stdin < /etc/jnpt-bootstrap/registry_token
      fi
      cd /opt/jnpt/repo/docker
      docker compose -f docker-compose.prod.yml pull
      docker compose -f docker-compose.prod.yml up -d
      install -m 0755 -o root -g root /opt/jnpt/repo/deploy/updater/jnpt-updater.sh /usr/local/sbin/jnpt-updater.sh
      install -m 0644 -o root -g root /opt/jnpt/repo/deploy/updater/jnpt-updater.service /etc/systemd/system/jnpt-updater.service
      install -m 0644 -o root -g root /opt/jnpt/repo/deploy/updater/jnpt-updater.timer /etc/systemd/system/jnpt-updater.timer
      systemctl daemon-reload
      systemctl enable --now jnpt-updater.timer
      # PAT-Quelldateien erst nach Erfolg löschen, damit ein Fehlversuch
      # wiederholt werden kann. Registry-Auth bleibt in /root/.docker/config.json.
      rm -f /etc/jnpt-bootstrap/git_token /etc/jnpt-bootstrap/registry_token

runcmd:
  # Docker Engine + Compose-Plugin (offizielles Repo).
  - install -m 0755 -d /etc/apt/keyrings
  - curl -fsSL https://download.docker.com/linux/ubuntu/gpg -o /etc/apt/keyrings/docker.asc
  - chmod a+r /etc/apt/keyrings/docker.asc
  - echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $(. /etc/os-release && echo $VERSION_CODENAME) stable" > /etc/apt/sources.list.d/docker.list
  - apt-get update
  - DEBIAN_FRONTEND=noninteractive apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin
  - systemctl enable --now docker
  - systemctl daemon-reload
  - systemctl enable --now jnpt-metadata-guard.service
  - install -d -m 0700 -o root -g root /etc/jnpt-bootstrap

  # Volume-Attachment ist eine separate API-Aktion: darauf warten. Formatieren
  # nur ohne bestehendes Dateisystem; ein Neuaufbau erhält die Daten.
  - 'for i in $(seq 1 60); do [ -b ${volume_device} ] && break; echo "warte auf volume…"; sleep 5; done'
  - 'blkid ${volume_device} || mkfs.ext4 -F -L jnpt-data ${volume_device}'
  - mkdir -p /mnt/jnpt-data
  - 'grep -q "/mnt/jnpt-data" /etc/fstab || echo "${volume_device} /mnt/jnpt-data ext4 defaults,nofail 0 2" >> /etc/fstab'
  - mount -a
  - mkdir -p /mnt/jnpt-data/jnpt-data /mnt/jnpt-data/caddy-data /mnt/jnpt-data/caddy-config /mnt/jnpt-data/tailscale-state
  # Das Projekt heißt jnpt (Top-Level name der Compose-Datei).
  - docker volume create --driver local --opt type=none --opt o=bind --opt device=/mnt/jnpt-data/jnpt-data jnpt_jnpt-data
  - docker volume create --driver local --opt type=none --opt o=bind --opt device=/mnt/jnpt-data/caddy-data jnpt_caddy-data
  - docker volume create --driver local --opt type=none --opt o=bind --opt device=/mnt/jnpt-data/caddy-config jnpt_caddy-config
  - docker volume create --driver local --opt type=none --opt o=bind --opt device=/mnt/jnpt-data/tailscale-state jnpt_tailscale-state
  - systemd-tmpfiles --create /etc/tmpfiles.d/jnpt-tunnel.conf
  - 'echo "JanuaPort bereit zur Dateiablage. Danach als root /usr/local/sbin/jnpt-start aufrufen (hetzner/README.md, #1497)." > /etc/motd'
