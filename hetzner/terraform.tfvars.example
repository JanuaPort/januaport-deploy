# Platzhalter-Vorlage für Hetzner (#776, #1497), keine Betreiberwerte.
# Nach terraform.tfvars kopieren (gitignored). Nur der API-Token gehört in
# Terraform/TF_VAR; Laufzeitgeheimnisse nach apply als Dateien ablegen (README).

# Hetzner-API-Token (Projekt → Security → API-Tokens, Read & Write):
hcloud_token = "PLACEHOLDER_hcloud_token"

# Master-Key, Tailscale-Authkey und optionale Git-/Registry-PATs NICHT hier
# setzen. Nach apply unter /etc/jnpt-bootstrap/ als root:root/0600 ablegen,
# wie den separaten Aktuator-Prüf-Token. Dateinamen und SSH-stdin in README.
# Alte gesetzte Variablen werden mit einer Migrationsmeldung abgewiesen.

# Domain / DNS (A-Record nach apply setzen):
domain      = "mcp.example.com"
acme_email  = "admin@example.com"
ts_hostname = "jnpt"

# Server / Standort (Typ-Verfügbarkeit je location vorher prüfen):
server_type = "cpx22"
location    = "nbg1"
# image       = "ubuntu-24.04"
# volume_size = 10

# SSH-Zugang: für die Dateiablage nach apply erforderlich. Bei bewusst leerer
# Liste vorher einen anderen sicheren Zugang herstellen; Tailnet läuft noch nicht.
ssh_public_key   = "ssh-ed25519 AAAA... dein-key"
ssh_allowed_cidr = ["203.0.113.4/32"]

# Öffentliche Web-Fläche standardmäßig geschlossen; bewusst freigeben:
# public_web_enabled = true

# Pflicht: gepinnter Image-Tag (kein latest), Prebuilt statt Build auf der VM.
image_ref = "ghcr.io/januaport/januaport:0.104.0"
# Privates GHCR: classic PAT mit read:packages manuell als registry_token-Datei.

# Versions-Check: beide leer = AUS (offline-first). Öffentliche URL/PUBLIC-Key,
# kein privater Signaturschlüssel. Ohne Prüfschlüssel bleibt der Check fail-closed.
# update_manifest_url = "https://updates.example.com/jnpt/manifest.json"
# update_public_keys  = "jnpt-2026=PUBLIC_KEY_PLACEHOLDER"
# Form: key_id=<base64(SPKI-DER)|hex>;key_id2=…

# Host-Aktuator: Repository-Allowlist, nur Repository, kein Tag oder Digest.
# updater_image_repo = "ghcr.io/januaport/januaport"
# Prüf-Token separat manuell unter /etc/jnpt-updater.token (root:root/0600).
# Ohne ihn bleibt der Aktuator inert; kein Token in user_data/State.

# Konfig-Quelle: nur Compose/Caddy/Tailscale-Dateien, kein Build auf der VM.
# git_repo = "https://github.com/JanuaPort/januaport.git"
# git_ref  = "v0.104.0"  # Release-Tag passend zum image_ref; auch voller Commit-SHA möglich.
# Das Default-Produkt-Repo ist PRIVAT: fein-granularen PAT (nur dieses Repo, Contents:read) manuell
# als git_token-Datei ablegen. jnpt-start verwendet dann GIT_ASKPASS.

# Optionaler signierter Plugin-Katalog, leer = kein Katalog (offline-first).
# update_plugins_url = "https://updates.example.org/plugins.json"
# SSH: IPv4 mindestens /8, IPv6 mindestens /16; breitere Netze einschließlich
# 0.0.0.0/0 und ::/0 werden von der Validierung abgewiesen.
