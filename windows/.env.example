# Repository/Tag plus mandatory immutable registry digest. Installer resolves
# the requested tag automatically; a digest can also be entered directly.
JANUAPORT_IMAGE=ghcr.io/januaport/januaport:0.87.1
JANUAPORT_IMAGE_DIGEST=81b25ca65d1cf3ff9c0bbf4d3b14fb5362debac9ed120db73cf5e2c5e18a4bfd

# Optional: bei LAN/VPN-Konflikten alle drei Werte gemeinsam anpassen.
# Ohne Einträge bleiben Bestandsprofile unverändert.
# JNPT_PLUGIN_SUBNET=172.21.0.0/16
# JNPT_PLUGIN_IP=172.21.0.2
# JNPT_PLUGIN_RANGE=172.21.128.0/17
