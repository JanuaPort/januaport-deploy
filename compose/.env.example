# .env.example — Betreiber-Konfiguration für compose/docker-compose.yml
# (JanuaPort/januaport#776). Kopieren nach `.env`, Werte eintragen. `.env` NIE
# committen (Secrets!) — .gitignore im Repo-Root schließt sie aus.
#
# Umfang: genau die JNPT_*-Envs, die docs/inbetriebnahme.md im Produkt-Repo als
# Betreiber-Envs nennt. JNPT_SSO_* ist dort als Familie benannt ("Runbook §11");
# die konkreten Namen unten stammen aus docker/docker-compose.prod.yml im
# Produkt-Repo. Weitere JNPT_*-Envs (Lizenz-Abruf, Versions-Check, SMTP, …)
# verwaltet die Anlage über die Admin-Oberfläche bzw. sind dort nicht als
# Betreiber-Env benannt — bewusst nicht hier dupliziert (siehe Abschlussbericht
# der Einführung, Abschnitt "bewusst weggelassen").

# ── Pflicht ────────────────────────────────────────────────────────────────

# Gepinnter Image-Tag aus der Registry. Kein `:latest` — reproduzierbarer Deploy.
JANUAPORT_IMAGE=ghcr.io/januaport/januaport:0.1.2

# ── Vault-Master-Schlüssel ───────────────────────────────────────────────────

# 64 Hex-Zeichen (`openssl rand -hex 32`). Leer lassen: Die Anlage erzeugt beim
# ersten Start selbst einen und zeigt ihn EINMALIG im Log (docs/inbetriebnahme.md
# §1.0) — diesen Wert sofort sichern (Passwortmanager, getrennt vom Server).
# Wer ihn hier vorab setzt, überspringt die Erzeugung.
JNPT_MASTER_KEY=

# ── SSO (Entra), Familie JNPT_SSO_* ──────────────────────────────────────────

# Schalter: SSO ein/aus. Leer/false-Werte der übrigen Zeilen werden bei
# ENABLED=false ignoriert.
JNPT_SSO_ENABLED=false
# Token-Issuer (v2-Endpoint) der Entra-App-Registrierung.
JNPT_SSO_ISSUER=
# Erwartete Audience (App-ID-URI) im Token.
JNPT_SSO_AUDIENCE=
# Client-ID des OAuth-Clients/Connectors.
JNPT_SSO_CLIENT_ID=
# Angeforderter Scope beim Authorize-Aufruf.
JNPT_SSO_AUTH_SCOPE=
# Name des Gruppen-/Rollen-Claims im Token.
JNPT_SSO_GROUPS_CLAIM=
# Sockel-Berechtigung für jeden erfolgreichen SSO-Login vor jeder
# Team-Zuordnung. Empfehlung: leer lassen (nie eine Integration).
JNPT_SSO_DEFAULT_SCOPE=
# Secret der Verzeichnis-Such-App (Graph), falls Nutzer/Gruppen nachgeschlagen
# werden sollen.
JNPT_SSO_DIRECTORY_CREDENTIAL=
# Client-ID der Verzeichnis-Such-App (Graph), falls genutzt.
JNPT_SSO_DIRECTORY_CLIENT_ID=

# ── Anbindungsweg (optional) ─────────────────────────────────────────────────

# Überschreibt nur den Ort des Laufzeit-Schlüssels eines Anbindungs-Beistellers
# (z. B. OpenAI-Tunnel). Ohne laufenden Beisteller wirkungslos, leer lassen.
JNPT_TUNNEL_KEY_FILE=

# ── Datei-basierte Betreiber-Konfiguration (optional) ────────────────────────

# Verzeichnis für Connector-Beschreibungen (YAML), beim Start gelesen.
# Leer = Standardpfad der Anlage.
JNPT_CONNECTORS_DIR=

# Verzeichnis für Datenbank-Integrations-Beschreibungen, beim Start gelesen.
# Leer = Standardpfad der Anlage.
JNPT_DATABASES_DIR=

# Verzeichnis der Kartei-Dateien (Wissens-/Ansprechpartner-Sätze, #647).
# Leer = Standardpfad /data/karteien.
JNPT_KARTEIEN_DIR=
