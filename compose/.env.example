# .env.example — Betreiber-Konfiguration für compose/docker-compose.yml
# (JanuaPort/januaport#776). Kopieren nach `.env`, Werte eintragen. `.env` NIE
# committen (Secrets!) — .gitignore im Repo-Root schließt sie aus.
#
# Umfang: genau die JNPT_*-Envs, die docs/inbetriebnahme.md im Produkt-Repo als
# Betreiber-Envs nennt. JNPT_SSO_* ist dort als Familie benannt ("Runbook §11");
# die konkreten Namen und JNPT_PUBLIC_URL (gehört funktional zum selben Block,
# s. u.) stammen aus docs/deploy-hetzner.md §11.6.2 und
# docker/docker-compose.prod.yml im Produkt-Repo. Weitere JNPT_*-Envs
# (Lizenz-Abruf, Versions-Check, SMTP, …) verwaltet die Anlage über die
# Admin-Oberfläche bzw. sind in docs/inbetriebnahme.md nicht als Betreiber-Env
# benannt — bewusst nicht hier dupliziert (JanuaPort/januaport#776, Abschnitt
# "bewusst weggelassen" im Abschlussbericht des Tickets).

# ── Pflicht ────────────────────────────────────────────────────────────────

# Gepinnter Image-Tag aus der Registry. Kein `:latest` — reproduzierbarer Deploy.
JANUAPORT_IMAGE=ghcr.io/januaport/januaport:0.59.0

# ── Vault-Master-Schlüssel ───────────────────────────────────────────────────

# 64 Hex-Zeichen (`openssl rand -hex 32`). Leer lassen: Die Anlage erzeugt beim
# ersten Start selbst einen und zeigt ihn EINMALIG im Log (docs/inbetriebnahme.md
# §1.0) — diesen Wert sofort sichern (Passwortmanager, getrennt vom Server).
# Wer ihn hier vorab setzt, überspringt die Erzeugung.
JNPT_MASTER_KEY=

# ── SSO (Entra), Familie JNPT_SSO_* + JNPT_PUBLIC_URL ────────────────────────
# Reihenfolge wie im Runbook-Beispiel (docs/deploy-hetzner.md §11.6.2).

# Schalter: SSO ein/aus. Bei false werden die übrigen JNPT_SSO_*-Werte
# ignoriert; leer gilt ebenfalls als ungesetzt.
JNPT_SSO_ENABLED=false
# Token-Issuer (v2-Endpoint) der Entra-App-Registrierung.
JNPT_SSO_ISSUER=
# Erwarteter aud-Claim des Tokens — bei v2.0-Tokens die Client-ID-GUID der
# RESSOURCEN-Registrierung (nicht die App-ID-URI; Details: Runbook §11.6.2).
JNPT_SSO_AUDIENCE=
# Volle MCP-URL inkl. /mcp-Pfad (https://<host>/mcp, OHNE Trailing-Slash) —
# muss exakt zum resource-Parameter passen, den der Client anfragt. Ohne diese
# Zeile funktioniert SSO nicht, auch wenn sie kein JNPT_SSO_-Präfix trägt.
JNPT_PUBLIC_URL=
# Resource-spezifischer Entra-Scope der Ressourcen-Registrierung, z. B.
# api://<ressourcen-client-id-guid>/access offline_access.
JNPT_SSO_AUTH_SCOPE=
# Anzeigewert der SEPARATEN Client-Registrierung für den OAuth-Flow (reine
# Anzeige im Leitstand, keine Validierung).
JNPT_SSO_CLIENT_ID=
# Name des Gruppen-/Rollen-Claims im Token.
JNPT_SSO_GROUPS_CLAIM=
# Sockel-Berechtigung für jeden erfolgreichen SSO-Login vor jeder
# Team-Zuordnung. Empfehlung: leer lassen (nie eine Integration).
JNPT_SSO_DEFAULT_SCOPE=
# Name des VAULT-CREDENTIALS mit dem Graph-Client-Secret für die
# Verzeichnis-Suche — der Secret-WERT selbst wird in der GUI hinterlegt,
# NICHT hier (Secrets gehören nie in Klartext-Envs).
JNPT_SSO_DIRECTORY_CREDENTIAL=
# Client-ID der Verzeichnis-Such-App (Graph), zusammen mit der obigen Zeile.
JNPT_SSO_DIRECTORY_CLIENT_ID=

# ── Anbindungsweg (optional) ─────────────────────────────────────────────────

# Für den optionalen OpenAI-Tunnel-Beisteller: überschreibt nur den Ort des
# Laufzeit-Schlüssels. Dieser generische Stack mountet — anders als die
# Produkt-Compose — KEIN /run/jnpt/tunnel-Verzeichnis von sich aus; wer den
# Beisteller nutzt, ergänzt den Mount selbst (siehe docker-compose.yml). Ohne
# Beisteller und ohne Mount bleibt die Zeile wirkungslos, leer lassen.
JNPT_TUNNEL_KEY_FILE=

# ── Datei-basierte Betreiber-Konfiguration (optional) ────────────────────────

# Verzeichnis für Connector-Beschreibungen (YAML), beim Start gelesen.
# Leer = Standardpfad der Anlage.
JNPT_CONNECTORS_DIR=

# Verzeichnis für Datenbank-Integrations-Beschreibungen, beim Start gelesen.
# Leer = Standardpfad der Anlage.
JNPT_DATABASES_DIR=

# Verzeichnis der Kartei-Dateien (Wissens-/Ansprechpartner-Sätze, #647).
# Leer = Standardpfad /data/karteien.
JNPT_KARTEIEN_DIR=
